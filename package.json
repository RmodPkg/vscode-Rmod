{
	"name": "vscode-Rmod",
	"displayName": "Rmod",
	"description": "Language support for the R package Rmod",
	"version": "0.2.0",
	"publisher": "RmodPkg",
	"homepage": "https://github.com/RmodPkg/vscode-Rmod#readme",
	"bugs": {
		"url": "https://github.com/RmodPkg/vscode-Rmod/issues"
	},
	"keywords": [
		"Rmod",
		"R",
		"dynamic models",
		"syntax highlighting"
	],
	"icon": "images/Rmod_sticker_10DPI.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/RmodPkg/vscode-Rmod.git"
	},
	"engines": {
		"vscode": "^1.75.0",
		"positron": "^2025.6.0"
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "sed '/<!-- demo:start -->/,/<!-- demo:end -->/c\\<img src=\"images/vscode-Rmod.png\" alt=\"Demo\" width=\"800\">' README.md > README.marketplace.md && vsce package --readme-path README.marketplace.md"
	},
	"devDependencies": {
		"@types/vscode": "^1.75.0",
		"@vscode/vsce": "^4.1.0",
		"typescript": "^5.4.0"
	},
	"activationEvents": [
		"onLanguage:rmod"
	],
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "rmod",
				"aliases": [
					"Rmod",
					"rmod"
				],
				"extensions": [
					".Rmod",
					".rmod"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "rmod",
				"scopeName": "source.rmod",
				"path": "./syntaxes/rmod.tmLanguage.json"
			}
		],
		"keybindings": [
			{
				"command": "rmod.executeSelectionOrLine",
				"key": "ctrl+enter",
				"when": "editorLangId == rmod"
			}
		],
		"commands": [
			{
				"command": "rmod.executeSelectionOrLine",
				"title": "Run Rmod selection or line"
			},
			{
				"command": "rmod.run",
				"title": "Run Rmod"
			},
			{
				"command": "rmod.runcpp",
				"title": "Run Rmod with C++"
			},
			{
				"command": "rmod.load",
				"title": "Load Rmod"
			},
			{
				"command": "rmod.loadcpp",
				"title": "Load Rmod with C++"
			},
			{
				"command": "rmod.write",
				"title": "Write Rmod to script"
			},
			{
				"command": "rmod.writecpp",
				"title": "Write Rmod to R/C++ package"
			},
			{
				"command": "rmod.preproc",
				"title": "Pre-process Rmod"
			}
		],
		"submenus": [
			{
				"id": "rmod.submenu",
				"label": "Rmod commands",
				"icon": "$(play)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"submenu": "rmod.submenu",
					"when": "resourceExtname == .Rmod || resourceExtname == .rmod",
					"group": "navigation"
				}
			],
			"rmod.submenu": [
				{
					"command": "rmod.run",
					"group": "group_1"
				},
				{
					"command": "rmod.runcpp",
					"group": "group_1"
				},
				{
					"command": "rmod.load",
					"group": "group_2"
				},
				{
					"command": "rmod.loadcpp",
					"group": "group_2"
				},
				{
					"command": "rmod.write",
					"group": "group_3"
				},
				{
					"command": "rmod.writecpp",
					"group": "group_3"
				},
				{
					"command": "rmod.preproc",
					"group": "group_4"
				}
			],
			"commandPalette": [
				{
					"command": "rmod.executeSelectionOrLine",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.run",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.runcpp",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.load",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.loadcpp",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.write",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.writecpp",
					"when": "editorLangId == rmod"
				},
				{
					"command": "rmod.preproc",
					"when": "editorLangId == rmod"
				}
			]
		}
	}
}
